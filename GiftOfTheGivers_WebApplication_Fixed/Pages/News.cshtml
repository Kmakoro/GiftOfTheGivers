@page
@model GiftOfTheGivers.Pages.NewsModel
@{ViewData["Title"]="News & Updates";ViewData["NavStyle"]="light";}
<section class="page-banner news-banner"><div class="container-fluid site-container"><span class="section-eyebrow light">News & updates</span><h1>Relief activity, shared as it happens.</h1><p>This page is connected to Employee-posted project updates, so the public view changes as the team posts new information.</p></div></section>
<section class="section-pad"><div class="container-fluid site-container"><div class="row g-4">@if(Model.Updates.Count==0){<div class="col-12"><div class="empty-state">No updates have been posted yet.</div></div>}@foreach(var u in Model.Updates){var img=u.ReliefProject.Title.Contains("Water",StringComparison.OrdinalIgnoreCase)?"https://images.pexels.com/photos/6646878/pexels-photo-6646878.jpeg?auto=compress&cs=tinysrgb&w=900":u.ReliefProject.Title.Contains("Disaster",StringComparison.OrdinalIgnoreCase)?"https://images.pexels.com/photos/6647178/pexels-photo-6647178.jpeg?auto=compress&cs=tinysrgb&w=900":"https://images.pexels.com/photos/6590928/pexels-photo-6590928.jpeg?auto=compress&cs=tinysrgb&w=900";<div class="col-md-6 col-xl-4"><article class="news-card"><img src="@img" alt="Relief activity" loading="lazy"/><div><div class="news-meta"><span>@u.ReliefProject.Location</span><span>@u.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</span></div><h2>@u.ReliefProject.Title</h2><p>@u.UpdateText</p><a asp-page="/Projects">View project <i class="bi bi-arrow-right"></i></a></div></article></div>}</div></div></section>
