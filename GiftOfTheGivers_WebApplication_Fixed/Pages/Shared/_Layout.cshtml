@{
    var navStyle = (ViewData["NavStyle"] as string ?? "dark").ToLowerInvariant();
    var isLightNav = navStyle == "light";
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#001837" />
    <meta name="description" content="Gift of the Givers Foundation — humanitarian relief, donations, volunteer coordination and community support." />
    <title>@ViewData["Title"] - Gift of the Givers</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@600;700;800&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@(isLightNav ? "light-nav-page" : "dark-nav-page")">
<a class="visually-hidden-focusable btn btn-light position-fixed top-0 start-0 m-2" style="z-index:9999" href="#main-content">Skip to main content</a>
<header class="public-header @(isLightNav ? "public-header-light" : "public-header-dark")" id="siteHeader">
    <nav class="navbar navbar-expand-xl @(isLightNav ? "navbar-light" : "navbar-dark")">
        <div class="container-fluid site-container">
            <a class="navbar-brand gotg-brand" asp-page="/Index" aria-label="Gift of the Givers home">
                <span class="brand-mark"><img src="~/images/gotg-mark.svg" alt="" width="44" height="44" /></span>
                <span><strong>Gift of the Givers</strong><small>FOUNDATION</small></span>
            </a>
            <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation"><span class="navbar-toggler-icon"></span></button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav ms-auto align-items-xl-center gap-xl-1 py-3 py-xl-0">
                    <li class="nav-item"><a class="nav-link @(currentPage=="/Index"?"active":"")" asp-page="/Index">Home</a></li>
                    <li class="nav-item"><a class="nav-link @(currentPage=="/About"?"active":"")" asp-page="/About">About Us</a></li>
                    <li class="nav-item"><a class="nav-link @(currentPage=="/Projects"?"active":"")" asp-page="/Projects">Projects</a></li>
                    <li class="nav-item"><a class="nav-link @(currentPage=="/Donate"?"active":"")" asp-page="/Donate">Donate</a></li>
                    <li class="nav-item"><a class="nav-link @(currentPage=="/Volunteer"?"active":"")" asp-page="/Volunteer">Volunteer</a></li>
                    <li class="nav-item"><a class="nav-link @(currentPage=="/News"?"active":"")" asp-page="/News">News</a></li>
                    <li class="nav-item"><a class="nav-link @(currentPage=="/Contact"?"active":"")" asp-page="/Contact">Contact</a></li>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        @if (User.IsInRole("Employee"))
                        {<li class="nav-item ms-xl-2"><a class="btn btn-outline-brand btn-sm px-3" asp-page="/Employee/Dashboard"><i class="bi bi-grid me-1"></i>Employee Portal</a></li>}
                        else if (User.IsInRole("Donor"))
                        {<li class="nav-item ms-xl-2"><a class="btn btn-outline-brand btn-sm px-3" asp-page="/Donor/Dashboard"><i class="bi bi-person-circle me-1"></i>My Account</a></li>}
                        <li class="nav-item"><form method="post" asp-page="/Account/Logout" class="ms-xl-1"><button class="btn btn-gold btn-sm px-3" type="submit">Logout</button></form></li>
                    }
                    else
                    {
                        <li class="nav-item ms-xl-2"><a class="btn btn-login btn-sm px-3" asp-page="/Account/Login">Login</a></li>
                        <li class="nav-item"><a class="btn btn-gold btn-sm px-3" asp-page="/Donate">Donate Now</a></li>
                    }
                </ul>
            </div>
        </div>
    </nav>
</header>
<main id="main-content" role="main" tabindex="-1">@RenderBody()</main>
<section class="trust-strip" aria-label="Platform highlights">
    <div class="container-fluid site-container"><div class="row g-0">
        <div class="col-6 col-lg trust-item"><i class="bi bi-shield-check"></i><div><strong>Secure Access</strong><span>Protected account access</span></div></div>
        <div class="col-6 col-lg trust-item"><i class="bi bi-file-earmark-check"></i><div><strong>Tax Certificates</strong><span>Printable proof of giving</span></div></div>
        <div class="col-6 col-lg trust-item"><i class="bi bi-database-check"></i><div><strong>Accountable Giving</strong><span>Clear donation records</span></div></div>
        <div class="col-6 col-lg trust-item"><i class="bi bi-people"></i><div><strong>Volunteer Driven</strong><span>Skills that serve</span></div></div>
        <div class="col-12 col-lg trust-item"><i class="bi bi-heart-pulse"></i><div><strong>Built for Relief</strong><span>Simple, usable workflows</span></div></div>
    </div></div>
</section>
<footer class="site-footer">
    <div class="container-fluid site-container py-5">
        <div class="row g-4 align-items-start">
            <div class="col-lg-5"><div class="d-flex align-items-center gap-3 mb-3"><img src="~/images/gotg-mark.svg" alt="" width="46" height="46"/><div><strong class="footer-brand">Gift of the Givers Foundation</strong><div class="footer-sub">HUMANITARIAN FOUNDATION</div></div></div><p class="footer-copy">Supporting humanitarian relief through giving, volunteering, community projects and coordinated response.</p></div>
            <div class="col-6 col-lg-2"><h2>Explore</h2><a asp-page="/About">About</a><a asp-page="/Projects">Projects</a><a asp-page="/News">News</a><a asp-page="/Contact">Contact</a></div>
            <div class="col-6 col-lg-2"><h2>Get involved</h2><a asp-page="/Donate">Donate</a><a asp-page="/Volunteer">Volunteer</a><a asp-page="/Account/Register">Create account</a><a asp-page="/Account/Login">Login</a></div>
            <div class="col-lg-3"><h2>South Africa</h2><p class="mb-1"><i class="bi bi-telephone me-2"></i>0800 786 911</p><p class="mb-1"><i class="bi bi-envelope me-2"></i>info@giftofthegivers.org</p><p class="small mt-3 mb-0">Working together to deliver relief with dignity, care and accountability.</p></div>
        </div>
        <hr/><div class="d-flex flex-column flex-md-row justify-content-between gap-2 small"><span>© 2026 Gift of the Givers Foundation</span><span>Humanity • Integrity • Compassion • Transparency</span></div>
    </div>
</footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body></html>
