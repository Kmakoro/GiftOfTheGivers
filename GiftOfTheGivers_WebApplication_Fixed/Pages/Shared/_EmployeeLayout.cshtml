@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    var employeeName = User.Identity?.Name ?? "Employee";
    var initial = string.IsNullOrWhiteSpace(employeeName) ? "E" : employeeName[..1].ToUpperInvariant();
}
<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="theme-color" content="#001837"/><title>@ViewData["Title"] - Employee Portal</title><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@600;700;800&display=swap" rel="stylesheet"/><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/><link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet"/><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/></head>
<body class="employee-body"><div class="employee-shell"><aside class="employee-sidebar" id="employeeSidebar"><a class="employee-logo" asp-page="/Index"><img src="~/images/gotg-mark.svg" alt="" width="44" height="44"/><span><strong>Gift of the Givers</strong><small>EMPLOYEE PORTAL</small></span></a><div class="employee-label">WORKSPACE</div><nav class="employee-nav" aria-label="Employee navigation"><a class="@(currentPage=="/Employee/Dashboard"?"active":"")" asp-page="/Employee/Dashboard"><i class="bi bi-grid-1x2-fill"></i><span>Dashboard</span></a><a asp-page="/Employee/ReliefProjects" asp-fragment="post-update"><i class="bi bi-send"></i><span>Post Update</span></a><a class="@(currentPage=="/Employee/ReliefProjects"?"active":"")" asp-page="/Employee/ReliefProjects"><i class="bi bi-box-seam-fill"></i><span>Relief Projects</span></a><a class="@(currentPage=="/Employee/Volunteers"?"active":"")" asp-page="/Employee/Volunteers"><i class="bi bi-people-fill"></i><span>Volunteer Sign-ups</span></a><a class="@(currentPage=="/Employee/Donations"?"active":"")" asp-page="/Employee/Donations"><i class="bi bi-heart-fill"></i><span>Donations</span></a><a class="@(currentPage=="/Employee/AuditLogs"?"active":"")" asp-page="/Employee/AuditLogs"><i class="bi bi-shield-check"></i><span>Audit Logs</span></a><a asp-page="/Index"><i class="bi bi-globe2"></i><span>Public Website</span></a></nav><form method="post" asp-page="/Account/Logout" class="mt-auto"><button class="employee-logout" type="submit"><i class="bi bi-box-arrow-left"></i><span>Logout</span></button></form></aside><div class="employee-main"><header class="employee-topbar"><button class="btn btn-link d-lg-none text-dark p-0" type="button" data-sidebar-toggle aria-label="Toggle employee menu"><i class="bi bi-list fs-3"></i></button><div class="ms-auto d-flex align-items-center gap-3"><span class="notification-dot"><i class="bi bi-bell"></i></span><div class="employee-user"><span class="avatar">@initial</span><div><small>Signed in as</small><strong>@employeeName</strong></div></div></div></header><main class="employee-content">@RenderBody()</main></div></div><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script><script src="~/js/site.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts",required:false)</body></html>
