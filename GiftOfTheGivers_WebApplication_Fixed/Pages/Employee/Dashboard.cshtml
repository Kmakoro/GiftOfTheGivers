@page
@model GiftOfTheGivers.Pages.Employee.DashboardModel
@{Layout="_EmployeeLayout";ViewData["Title"]="Employee Dashboard";}
<div class="dashboard-heading d-flex flex-wrap justify-content-between align-items-end gap-3"><div><span class="section-eyebrow">Employee workspace</span><h1>Dashboard</h1><p>Manage relief projects, donations and volunteer activity from one place.</p></div><a class="btn btn-brand" asp-page="/Employee/ReliefProjects" asp-fragment="post-update"><i class="bi bi-send me-2"></i>Post Project Update</a></div>
<div class="row g-3 mb-4"><div class="col-6 col-xl-3"><div class="admin-stat"><span><i class="bi bi-cash-stack"></i></span><div><small>ZAR donations</small><strong>R @Model.ZarDonationTotal.ToString("N0")</strong><em>@Model.DonationCount total records</em></div></div></div><div class="col-6 col-xl-3"><div class="admin-stat"><span><i class="bi bi-people"></i></span><div><small>Volunteers</small><strong>@Model.VolunteerCount</strong><em>applications stored</em></div></div></div><div class="col-6 col-xl-3"><div class="admin-stat"><span class="gold"><i class="bi bi-box-seam"></i></span><div><small>Active projects</small><strong>@Model.ActiveProjectCount</strong><em>relief operations</em></div></div></div><div class="col-6 col-xl-3"><div class="admin-stat"><span><i class="bi bi-shield-check"></i></span><div><small>Security</small><strong>Role-based</strong><em>Employee access only</em></div></div></div></div>
<div class="row g-3 mb-4"><div class="col-xl-7"><div class="admin-card h-100"><div class="card-head"><div><span>Donation activity</span><h2>Recent Donations</h2></div><a asp-page="/Employee/Donations">View all</a></div>@if(Model.RecentDonations.Count==0){<div class="empty-state small">No donations recorded yet.</div>}else{<div class="table-responsive"><table class="table modern-table admin-table"><thead><tr><th>Donor</th><th>Amount</th><th>Type</th><th>Date</th></tr></thead><tbody>@foreach(var d in Model.RecentDonations){<tr><td>@(d.IsAnonymous?"Anonymous":d.DonorName)</td><td><strong>@d.Currency @d.Amount.ToString("N0")</strong></td><td>@d.Frequency</td><td>@d.DonationDate.ToLocalTime().ToString("dd MMM")</td></tr>}</tbody></table></div>}</div></div><div class="col-xl-5"><div class="admin-card h-100"><div class="card-head"><div><span>Volunteer activity</span><h2>Recent Sign-ups</h2></div><a asp-page="/Employee/Volunteers">View all</a></div>@if(Model.RecentVolunteers.Count==0){<div class="empty-state small">No volunteer sign-ups yet.</div>}@foreach(var v in Model.RecentVolunteers){<div class="signup-row"><span class="avatar">@v.FullName.Substring(0,1)</span><div><strong>@v.FullName</strong><small>@v.Email</small></div><span class="ms-auto soft-badge">@v.Availability</span></div>}</div></div></div>
<div class="row g-3"><div class="col-xl-8"><div class="admin-card h-100"><div class="card-head"><div><span>Relief operations</span><h2>Recently Updated Projects</h2></div><a asp-page="/Employee/ReliefProjects">Manage projects</a></div><div class="project-admin-list">@foreach(var p in Model.RecentProjects){<div><span class="project-dot"></span><p><strong>@p.Title</strong><small>@p.Location • @p.Status</small></p><span>@p.LastUpdated.ToLocalTime().ToString("dd MMM")</span></div>}</div></div></div><div class="col-xl-4"><div class="admin-card h-100"><div class="card-head"><div><span>Quick access</span><h2>Actions</h2></div></div><div class="quick-grid"><a class="quick-action primary" asp-page="/Employee/ReliefProjects" asp-fragment="post-update"><i class="bi bi-pencil-square"></i><span>Post Update</span></a><a class="quick-action" asp-page="/Employee/ReliefProjects"><i class="bi bi-plus-circle"></i><span>Add Project</span></a><a class="quick-action" asp-page="/Employee/Volunteers"><i class="bi bi-people"></i><span>Volunteers</span></a><a class="quick-action" asp-page="/Employee/Donations"><i class="bi bi-heart"></i><span>Donations</span></a></div></div></div></div>
