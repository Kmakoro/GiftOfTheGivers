@page
@model GiftOfTheGivers.Pages.Employee.DonationsModel
@{Layout="_EmployeeLayout";ViewData["Title"]="Donation Records";}
<div class="dashboard-heading"><span class="section-eyebrow">Employee workspace</span><h1>Donation Records</h1><p>Review saved donation data, privacy choice, type, currency and generated certificate number.</p></div><div class="admin-card">@if(Model.Donations.Count==0){<div class="empty-state">No donation records are available yet.</div>}else{<div class="table-responsive"><table class="table modern-table align-middle"><thead><tr><th>Certificate</th><th>Donor</th><th>Amount</th><th>Type</th><th>Privacy</th><th>Date</th></tr></thead><tbody>@foreach(var d in Model.Donations){<tr><td><span class="mono-small">@(d.TaxCertificate?.CertificateNumber??"Pending")</span></td><td><strong>@(d.IsAnonymous?"Anonymous":d.DonorName)</strong><br/><small class="text-muted">@d.DonorEmail</small></td><td><strong>@d.Currency @d.Amount.ToString("N2")</strong></td><td><span class="soft-badge">@d.Frequency</span></td><td>@(d.IsAnonymous?"Anonymous":"Named")</td><td>@d.DonationDate.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td></tr>}</tbody></table></div>}</div>
