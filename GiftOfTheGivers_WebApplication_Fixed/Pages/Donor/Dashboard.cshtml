@page
@model GiftOfTheGivers.Pages.Donor.DashboardModel
@{ViewData["Title"]="Donor Dashboard";ViewData["NavStyle"]="light";}
<section class="donor-dashboard section-pad"><div class="container-fluid site-container"><div class="donor-hero"><div><span class="section-eyebrow light">Donor account • Protected</span><h1>Welcome back, @Model.CurrentUser?.FirstName.</h1><p>Keep your giving history and certificates in one place.</p></div><a class="btn btn-gold btn-lg" asp-page="/Donate">Donate Again <i class="bi bi-heart-fill ms-2"></i></a></div><div class="row g-3 my-4"><div class="col-md-4"><div class="metric-white"><span><i class="bi bi-heart"></i></span><div><small>Donation records</small><strong>@Model.Donations.Count</strong></div></div></div><div class="col-md-4"><div class="metric-white"><span><i class="bi bi-arrow-repeat"></i></span><div><small>Recurring donations</small><strong>@Model.RecurringCount</strong></div></div></div><div class="col-md-4"><div class="metric-white"><span><i class="bi bi-currency-exchange"></i></span><div><small>Currencies used</small><strong>@Model.Donations.Select(d=>d.Currency).Distinct().Count()</strong></div></div></div></div><div class="dashboard-card"><div class="dashboard-card-head"><div><span class="section-eyebrow">Giving history</span><h2>Your Donations</h2></div><a class="btn btn-outline-brand btn-sm" asp-page="/Donate">New Donation</a></div>@if(Model.Donations.Count==0){<div class="empty-state"><i class="bi bi-heart"></i><h3>No donations yet</h3><p>Your future donations will appear here.</p><a class="btn btn-brand" asp-page="/Donate">Make your first donation</a></div>}else{<div class="table-responsive"><table class="table modern-table align-middle"><thead><tr><th>Date</th><th>Amount</th><th>Type</th><th>Privacy</th><th>Certificate</th></tr></thead><tbody>@foreach(var d in Model.Donations){<tr><td>@d.DonationDate.ToLocalTime().ToString("dd MMM yyyy")</td><td><strong>@d.Currency @d.Amount.ToString("N2")</strong></td><td><span class="soft-badge">@d.Frequency</span></td><td>@(d.IsAnonymous?"Anonymous":"Named")</td><td>@if(d.TaxCertificate is not null){<a class="btn btn-sm btn-outline-brand" asp-page="/Certificate" asp-route-id="@d.DonationId"><i class="bi bi-download me-1"></i>Certificate</a>}else{<span class="text-muted">Pending</span>}</td></tr>}</tbody></table></div>}</div></div></section>
