@page
@model GiftOfTheGivers.Pages.DonateModel
@{ViewData["Title"]="Donate";ViewData["NavStyle"]="light";}
<section class="donate-hero"><div class="container-fluid site-container"><div class="row g-0 donation-shell"><div class="col-lg-5 donation-visual"><img src="https://images.pexels.com/photos/6646878/pexels-photo-6646878.jpeg?auto=compress&cs=tinysrgb&w=1200" onerror="this.onerror=null;this.src='/images/donate-community.jpg';" alt="Volunteers distributing food and medicine"/><div class="donation-visual-copy"><span class="section-eyebrow light">Give with purpose</span><h1>Your contribution can become relief, dignity and hope.</h1><p>Choose how you would like to give and receive a personalised donation certificate for your records.</p><div class="visual-trust"><span><i class="bi bi-shield-lock"></i>Validated</span><span><i class="bi bi-receipt"></i>Certificate</span><span><i class="bi bi-eye"></i>Transparent</span></div></div></div><div class="col-lg-7 donation-form-side"><div class="donation-form-wrap"><div class="d-flex justify-content-between align-items-start gap-3 mb-4"><div><span class="section-eyebrow">Donation</span><h2>Make a Donation</h2><p>Choose your amount, currency and donation type.</p></div><i class="bi bi-heart-fill donate-heart"></i></div>
@if(User.Identity?.IsAuthenticated==true&&User.IsInRole("Donor")){<div class="notice success"><i class="bi bi-person-check"></i><span>Signed in as a Donor. This donation will appear in your account.</span></div>}else{<div class="notice"><i class="bi bi-person"></i><span>No account required. You can donate as a guest or choose to remain anonymous.</span></div>}
<form method="post" novalidate><div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div><div class="segmented-control mb-4"><input class="btn-check" asp-for="Input.Frequency" id="freq-one" type="radio" value="One-time"/><label class="segment-label" for="freq-one"><i class="bi bi-lightning"></i>One-time</label><input class="btn-check" asp-for="Input.Frequency" id="freq-recurring" type="radio" value="Recurring"/><label class="segment-label" for="freq-recurring"><i class="bi bi-arrow-repeat"></i>Recurring</label></div><span asp-validation-for="Input.Frequency" class="text-danger small"></span>
<div class="mb-4"><label class="form-label">Choose amount</label><div class="amount-grid"><button type="button" class="amount-chip" data-amount="250">R250</button><button type="button" class="amount-chip" data-amount="500">R500</button><button type="button" class="amount-chip active" data-amount="1000">R1 000</button><button type="button" class="amount-chip" data-amount="2500">R2 500</button><button type="button" class="amount-chip" data-amount="5000">R5 000</button><button type="button" class="amount-chip" data-amount="">Other</button></div></div>
<div class="mb-4"><label class="form-label">Currency</label><div class="currency-grid">@foreach(var currency in Model.Currencies){var id=$"currency-{currency.Code}";<input class="btn-check" asp-for="Input.Currency" id="@id" type="radio" value="@currency.Code"/><label class="currency-chip" for="@id"><strong>@currency.Code</strong><span>@currency.DisplayName</span></label>}</div><span asp-validation-for="Input.Currency" class="text-danger small"></span></div>
<div class="mb-3"><label asp-for="Input.Amount" class="form-label">Amount (<span id="currencyCode">ZAR</span>)</label><div class="input-group input-group-lg"><span class="input-group-text"><i class="bi bi-cash"></i></span><input asp-for="Input.Amount" id="donationAmount" class="form-control" min="1" step="0.01" inputmode="decimal" value="1000"/></div><span asp-validation-for="Input.Amount" class="text-danger small"></span></div>
<div class="row g-3 mb-3"><div class="col-md-6"><label asp-for="Input.DonorName" class="form-label"></label><input asp-for="Input.DonorName" class="form-control form-control-lg" autocomplete="name" placeholder="Full name"/><span asp-validation-for="Input.DonorName" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="Input.DonorEmail" class="form-label"></label><input asp-for="Input.DonorEmail" class="form-control form-control-lg" autocomplete="email" placeholder="Email address"/><span asp-validation-for="Input.DonorEmail" class="text-danger small"></span></div></div>
<label class="anonymous-box mb-4"><input asp-for="Input.IsAnonymous" class="form-check-input"/><span><strong>Make this donation anonymous</strong><small>Your name will not be shown publicly. Your receipt still uses the information above.</small></span></label>
<button type="submit" class="btn btn-gold btn-lg w-100 donate-submit"><i class="bi bi-lock-fill me-2"></i>Donate Securely</button><p class="form-footnote"><i class="bi bi-shield-check"></i>Your donation details are validated before they are recorded.</p></form></div></div></div></div></div></section>
<section class="section-pad bg-soft"><div class="container-fluid site-container"><div class="row g-4"><div class="col-md-4"><div class="value-card compact"><span><i class="bi bi-receipt"></i></span><h2>Certificate generated</h2><p>A unique certificate number is created for each successfully recorded donation.</p></div></div><div class="col-md-4"><div class="value-card compact"><span><i class="bi bi-arrow-repeat"></i></span><h2>Recurring supported</h2><p>Recurring donations create a monthly donation schedule in the database.</p></div></div><div class="col-md-4"><div class="value-card compact"><span><i class="bi bi-currency-exchange"></i></span><h2>Three currencies</h2><p>Choose ZAR, USD or EUR and keep the selected currency with the donation record.</p></div></div></div></div></section>
@section Scripts{<partial name="_ValidationScriptsPartial"/>}
