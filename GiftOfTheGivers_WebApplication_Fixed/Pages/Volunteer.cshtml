@page
@model GiftOfTheGivers.Pages.VolunteerModel
@{ViewData["Title"]="Volunteer";ViewData["NavStyle"]="light";}
<section class="volunteer-page"><div class="container-fluid site-container py-5 py-lg-6"><div class="row g-5 align-items-center"><div class="col-lg-5"><span class="section-eyebrow">Volunteer</span><h1 class="page-display">Bring your skills. Help make a real difference.</h1><p class="section-copy">Share your details, skills and availability so the volunteer team can match you with suitable opportunities.</p><div class="benefit-list"><div><span><i class="bi bi-heart"></i></span><p><strong>Make a real impact</strong><small>Your effort supports people in need.</small></p></div><div><span><i class="bi bi-stars"></i></span><p><strong>Gain experience</strong><small>Build teamwork and service skills.</small></p></div><div><span><i class="bi bi-people"></i></span><p><strong>Be part of a team</strong><small>Contribute alongside committed people.</small></p></div><div><span><i class="bi bi-clock"></i></span><p><strong>Flexible opportunities</strong><small>Tell us when you are available.</small></p></div></div><img class="volunteer-inline-image" src="https://images.pexels.com/photos/6647178/pexels-photo-6647178.jpeg?auto=compress&cs=tinysrgb&w=1100" onerror="this.onerror=null;this.src='/images/volunteer-team.jpg';" alt="Volunteers carrying food aid boxes"/></div><div class="col-lg-7"><div class="form-surface"><div class="form-surface-head"><div><span class="section-eyebrow">Registration</span><h2>Volunteer Application</h2><p>Fields marked required must be completed.</p></div><span class="round-icon"><i class="bi bi-person-plus"></i></span></div>@if(!string.IsNullOrWhiteSpace(Model.SuccessMessage)){<div class="notice success"><i class="bi bi-check-circle"></i><span>@Model.SuccessMessage</span></div>}<form method="post" novalidate><div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div><div class="row g-3"><div class="col-md-6"><label asp-for="Input.FullName" class="form-label"></label><input asp-for="Input.FullName" class="form-control form-control-lg" placeholder="Your full name"/><span asp-validation-for="Input.FullName" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="Input.Email" class="form-label"></label><input asp-for="Input.Email" class="form-control form-control-lg" placeholder="you@example.com"/><span asp-validation-for="Input.Email" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="Input.Phone" class="form-label"></label><input asp-for="Input.Phone" class="form-control form-control-lg" placeholder="+27 ..."/><span asp-validation-for="Input.Phone" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="Input.Availability" class="form-label"></label><select asp-for="Input.Availability" class="form-select form-select-lg"><option value="">Select availability</option><option>Weekdays</option><option>Weekends</option><option>Evenings</option><option>Flexible</option></select><span asp-validation-for="Input.Availability" class="text-danger small"></span></div><div class="col-12"><label asp-for="Input.Skills" class="form-label">Skills and experience</label><textarea asp-for="Input.Skills" class="form-control" rows="5" placeholder="Examples: first aid, driving, logistics, administration, IT support, counselling..."></textarea><span asp-validation-for="Input.Skills" class="text-danger small"></span></div></div><button class="btn btn-brand btn-lg w-100 mt-4" type="submit">Submit Application <i class="bi bi-arrow-right ms-2"></i></button><p class="form-footnote"><i class="bi bi-database-check"></i>Your application will be recorded for the volunteer coordination team to review.</p></form></div></div></div></div></section>
@section Scripts{<partial name="_ValidationScriptsPartial"/>}
