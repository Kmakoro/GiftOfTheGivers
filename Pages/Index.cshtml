@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<section class="gg-hero">
    <div class="container">
        <span class="badge bg-warning text-dark mb-3">Disaster relief, coordinated</span>
        <h1 class="display-5 fw-bold">Best among people are those who benefit mankind</h1>
        <p class="lead mt-3">
            A single hub for the Gift of the Givers Foundation to coordinate relief projects, mobilise
            volunteers and channel donations to the communities that need them first.
        </p>
        <div class="d-flex flex-wrap gap-2 mt-4">
            <a class="btn gg-btn-donate btn-lg" asp-page="/Donations/Index">Donate now</a>
            <a class="btn btn-outline-light btn-lg" asp-page="/Volunteers/Register">Become a volunteer</a>
        </div>
    </div>
</section>

<section class="gg-section">
    <div class="container">
        <div class="row g-3">
            <div class="col-6 col-lg-3">
                <div class="gg-stat">
                    <div class="value">@Model.ActiveProjects</div>
                    <div class="text-muted small">Active relief projects</div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="gg-stat">
                    <div class="value">@Model.VolunteerCount</div>
                    <div class="text-muted small">Registered volunteers</div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="gg-stat">
                    <div class="value">@Model.DonationCount</div>
                    <div class="text-muted small">Donations received</div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="gg-stat">
                    <div class="value">R @Model.TotalRaised.ToString("N0")</div>
                    <div class="text-muted small">Raised (ZAR equivalent)</div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="gg-section gg-section-alt">
    <div class="container">
        <h2 class="h3 mb-4">Where we are working right now</h2>
        <div class="row g-4">
            @foreach (var project in Model.Projects)
            {
                <div class="col-md-4">
                    <div class="gg-card p-4">
                        <span class="badge badge-status-@project.Status">@project.Status</span>
                        <h3 class="h5 mt-3">@project.Name</h3>
                        <p class="text-muted small mb-2">@project.Location</p>
                        <p class="small">@project.Description</p>
                        <a class="btn btn-primary btn-sm" asp-page="/Donations/Index" asp-route-projectId="@project.Id">
                            Support this project
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<section class="gg-section">
    <div class="container">
        <div class="row align-items-center g-4">
            <div class="col-lg-6">
                <h2 class="h3">Three ways this platform helps</h2>
                <ul class="mt-3">
                    <li class="mb-2"><strong>Coordinate relief.</strong> Employees post live updates against each project so field teams and the public share one source of truth.</li>
                    <li class="mb-2"><strong>Mobilise people.</strong> Volunteers register their skills and availability so coordinators can match them to needs in minutes.</li>
                    <li class="mb-2"><strong>Fund the response.</strong> One-time and recurring donations in ZAR, USD or EUR, each with an instant tax certificate.</li>
                </ul>
            </div>
            <div class="col-lg-6">
                <div class="gg-card p-4">
                    <h3 class="h5">Latest field updates</h3>
                    @if (!Model.RecentUpdates.Any())
                    {
                        <p class="text-muted small mb-0">No updates posted yet.</p>
                    }
                    else
                    {
                        <ul class="list-unstyled mb-0">
                            @foreach (var update in Model.RecentUpdates)
                            {
                                <li class="border-bottom py-2">
                                    <div class="fw-semibold">@update.Title</div>
                                    <div class="small text-muted">@update.ReliefProject?.Name • @update.PostedAt.ToString("dd MMM yyyy")</div>
                                    <div class="small">@update.Body</div>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>
    </div>
</section>
