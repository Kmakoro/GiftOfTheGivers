@page
@model GiftOfTheGivers.Pages.Employee.ReliefProjectsModel
@{Layout="_EmployeeLayout";ViewData["Title"]="Relief Projects";}
<div class="dashboard-heading"><span class="section-eyebrow">Employee workspace</span><h1>Relief Projects & Updates</h1><p>Create projects and publish operational updates that appear on the public website.</p></div>@if(TempData["Message"] is string message){<div class="notice success mb-4"><i class="bi bi-check-circle"></i><span>@message</span></div>}<div class="row g-4" id="post-update"><div class="col-xl-5"><div class="admin-card sticky-xl-top" style="top:88px"><div class="card-head"><div><span>New relief operation</span><h2>Create Project</h2></div><i class="bi bi-plus-circle fs-3 text-success"></i></div><form method="post" asp-page-handler="Create" novalidate><div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div><div class="mb-3"><label asp-for="Input.Title" class="form-label"></label><input asp-for="Input.Title" class="form-control form-control-lg"/><span asp-validation-for="Input.Title" class="text-danger small"></span></div><div class="mb-3"><label asp-for="Input.Location" class="form-label"></label><input asp-for="Input.Location" class="form-control form-control-lg"/><span asp-validation-for="Input.Location" class="text-danger small"></span></div><div class="mb-3"><label asp-for="Input.Description" class="form-label"></label><textarea asp-for="Input.Description" class="form-control" rows="4"></textarea><span asp-validation-for="Input.Description" class="text-danger small"></span></div><div class="row g-3"><div class="col-sm-6"><label asp-for="Input.Status" class="form-label"></label><select asp-for="Input.Status" class="form-select">@foreach(var status in Model.Statuses){<option value="@status.Code">@status.DisplayName</option>}</select></div><div class="col-sm-6"><label asp-for="Input.StartDate" class="form-label"></label><input asp-for="Input.StartDate" class="form-control" type="date"/></div></div><button class="btn btn-brand w-100 mt-4" type="submit">Create Project</button></form></div></div><div class="col-xl-7">@if(Model.Projects.Count==0){<div class="empty-state">No relief projects have been created yet.</div>}@foreach(var p in Model.Projects){<article class="admin-project-card"><div class="d-flex justify-content-between gap-3"><div><span class="soft-badge">@p.Status</span><h2>@p.Title</h2><p class="project-location"><i class="bi bi-geo-alt"></i>@p.Location • Starts @p.StartDate.ToString("dd MMM yyyy")</p></div><i class="bi bi-box-seam fs-3 text-success"></i></div><p>@p.Description</p><div class="post-update-box"><h3>Post Project Update</h3><form method="post" asp-page-handler="AddUpdate"><input type="hidden" name="reliefProjectId" value="@p.ReliefProjectId"/><label class="visually-hidden" for="update-@p.ReliefProjectId">Project update</label><textarea id="update-@p.ReliefProjectId" class="form-control" name="updateText" rows="3" maxlength="1500" placeholder="Write a clear public update..." required></textarea><button class="btn btn-dark mt-2" type="submit"><i class="bi bi-send me-1"></i>Post Update</button></form></div>@if(p.Updates.Count>0){<div class="updates-list">@foreach(var u in p.Updates.OrderByDescending(x=>x.CreatedAt).Take(3)){<div class="update-item"><p>@u.UpdateText</p><small>@u.CreatedAt.ToLocalTime().ToString("dd MMM yyyy • HH:mm")</small></div>}</div>}else{<div class="text-muted small mt-3">No updates posted yet.</div>}</article>}</div></div>
@section Scripts{<partial name="_ValidationScriptsPartial"/>}
