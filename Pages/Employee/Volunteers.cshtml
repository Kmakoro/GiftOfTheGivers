@page
@model GiftOfTheGivers.Pages.Employee.VolunteersModel
@{Layout="_EmployeeLayout";ViewData["Title"]="Volunteer Sign-ups";}
<div class="dashboard-heading"><span class="section-eyebrow">Employee workspace</span><h1>Volunteer Sign-ups</h1><p>Review the contact details, skills and availability submitted through the public volunteer form.</p></div><div class="admin-card">@if(Model.Volunteers.Count==0){<div class="empty-state">No volunteer applications are available yet.</div>}else{<div class="table-responsive"><table class="table modern-table align-middle"><thead><tr><th>Volunteer</th><th>Contact</th><th>Skills</th><th>Availability</th><th>Submitted</th></tr></thead><tbody>@foreach(var v in Model.Volunteers){<tr><td><div class="d-flex align-items-center gap-2"><span class="table-avatar">@v.FullName.Substring(0,1)</span><strong>@v.FullName</strong></div></td><td>@v.Email<br/><small class="text-muted">@v.Phone</small></td><td>@v.Skills</td><td><span class="soft-badge">@v.Availability</span></td><td>@v.DateSubmitted.ToLocalTime().ToString("dd MMM yyyy")</td></tr>}</tbody></table></div>}</div>
