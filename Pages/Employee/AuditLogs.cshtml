@page
@model GiftOfTheGivers.Pages.Employee.AuditLogsModel
@{Layout="_EmployeeLayout";ViewData["Title"]="Audit Log";}
<div class="dashboard-heading"><span class="section-eyebrow">Employee workspace</span><h1>Audit Log</h1><p>Review recent sign-in events and important activity across the platform.</p></div><div class="admin-card">@if(Model.Logs.Count==0){<div class="empty-state">No audit events have been recorded yet.</div>}else{<div class="table-responsive"><table class="table modern-table align-middle"><thead><tr><th>Time</th><th>Action</th><th>Entity</th><th>Details</th></tr></thead><tbody>@foreach(var log in Model.Logs){<tr><td>@log.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td><td><span class="soft-badge">@log.Action</span></td><td>@log.EntityName @log.EntityId</td><td>@log.Details</td></tr>}</tbody></table></div>}</div>
