@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<section class="gg-section">
    <div class="container">
        <h1 class="h3 text-danger">Something went wrong</h1>
        <p>An unexpected error occurred while processing your request.</p>
        @if (Model.ShowRequestId)
        {
            <p class="small text-muted"><strong>Request ID:</strong> <code>@Model.RequestId</code></p>
        }
        <a class="btn btn-primary" asp-page="/Index">Back to home</a>
    </div>
</section>
