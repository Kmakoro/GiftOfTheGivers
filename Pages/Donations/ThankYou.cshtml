@page
@model GiftOfTheGivers.Pages.Donations.ThankYouModel
@{
    ViewData["Title"] = "Thank you";
}

<section class="gg-section">
    <div class="container">
        <div class="gg-card p-4 p-md-5">
            <span class="badge bg-success mb-3">Donation recorded</span>
            <h1 class="h3">Thank you, @(Model.Donation!.IsAnonymous ? "anonymous friend" : Model.Donation.DonorName).</h1>
            <p>Your contribution helps the foundation move faster when a disaster strikes.</p>

            <dl class="row small mt-4">
                <dt class="col-sm-4">Reference</dt>
                <dd class="col-sm-8">@Model.Donation.Reference</dd>

                <dt class="col-sm-4">Amount</dt>
                <dd class="col-sm-8">@Model.Donation.Currency @Model.Donation.Amount.ToString("N2")</dd>

                <dt class="col-sm-4">Type</dt>
                <dd class="col-sm-8">@(Model.Donation.Frequency == GiftOfTheGivers.Models.DonationFrequency.Monthly ? "Recurring monthly" : "One-time")</dd>

                <dt class="col-sm-4">Designated to</dt>
                <dd class="col-sm-8">@(Model.Donation.ReliefProject?.Name ?? "Where the need is greatest")</dd>

                <dt class="col-sm-4">Certificate number</dt>
                <dd class="col-sm-8">@Model.Donation.TaxCertificate?.CertificateNumber</dd>
            </dl>

            <a class="btn btn-primary" asp-page="/Donations/Certificate" asp-route-reference="@Model.Donation.Reference">
                Download tax certificate (PDF)
            </a>
            <a class="btn btn-outline-secondary" asp-page="/Index">Back to home</a>
        </div>
    </div>
</section>
