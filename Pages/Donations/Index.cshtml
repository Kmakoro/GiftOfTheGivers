@page
@model GiftOfTheGivers.Pages.Donations.IndexModel
@{
    ViewData["Title"] = "Donate";
}

<section class="gg-hero py-5">
    <div class="container">
        <h1 class="display-6 fw-bold">Make a donation</h1>
        <p class="lead mb-0">Give once or monthly, in ZAR, USD or EUR. A tax certificate is generated
            immediately for every donation — including anonymous gifts.</p>
    </div>
</section>

<section class="gg-section">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-7">
                <form method="post" class="gg-card p-4">
                    <div asp-validation-summary="ModelOnly" class="text-danger small"></div>

                    <fieldset class="mb-4">
                        <legend class="h6">Donation type</legend>
                        <div class="btn-group" role="group">
                            <input class="btn-check" type="radio" asp-for="Input.Frequency" id="freqOnce"
                                   value="@GiftOfTheGivers.Models.DonationFrequency.OneTime" />
                            <label class="btn btn-outline-primary" for="freqOnce">One-time</label>

                            <input class="btn-check" type="radio" asp-for="Input.Frequency" id="freqMonthly"
                                   value="@GiftOfTheGivers.Models.DonationFrequency.Monthly" />
                            <label class="btn btn-outline-primary" for="freqMonthly">Monthly (recurring)</label>
                        </div>
                    </fieldset>

                    <div class="row g-3">
                        <div class="col-sm-4">
                            <label asp-for="Input.Currency" class="form-label"></label>
                            <select asp-for="Input.Currency" class="form-select"
                                    asp-items="Html.GetEnumSelectList<GiftOfTheGivers.Models.Currency>()"></select>
                        </div>
                        <div class="col-sm-8">
                            <label asp-for="Input.Amount" class="form-label"></label>
                            <input asp-for="Input.Amount" class="form-control" step="0.01" />
                            <span asp-validation-for="Input.Amount" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mt-3">
                        <label asp-for="Input.ReliefProjectId" class="form-label"></label>
                        <select asp-for="Input.ReliefProjectId" class="form-select" asp-items="Model.ProjectOptions">
                            <option value="">Where the need is greatest</option>
                        </select>
                    </div>

                    <div class="form-check mt-4">
                        <input class="form-check-input" type="checkbox" asp-for="Input.IsAnonymous" id="anon" />
                        <label class="form-check-label" for="anon">Donate as an anonymous guest</label>
                    </div>

                    <div class="row g-3 mt-1">
                        <div class="col-sm-6">
                            <label asp-for="Input.DonorName" class="form-label"></label>
                            <input asp-for="Input.DonorName" class="form-control" />
                            <span asp-validation-for="Input.DonorName" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="Input.DonorEmail" class="form-label"></label>
                            <input asp-for="Input.DonorEmail" class="form-control" />
                            <span asp-validation-for="Input.DonorEmail" class="text-danger small"></span>
                        </div>
                    </div>

                    <button type="submit" class="btn gg-btn-donate mt-4">Complete donation</button>
                    <p class="small text-muted mt-3 mb-0">Prototype stage: no payment gateway is connected and
                        amounts are symbolic. A dummy donation record and tax certificate are created.</p>
                </form>
            </div>

            <div class="col-lg-5">
                <div class="gg-card p-4">
                    <h2 class="h5">Where your money goes</h2>
                    <ul class="small">
                        <li class="mb-2">R250 — a family food parcel for one week.</li>
                        <li class="mb-2">R750 — emergency water purification for a household.</li>
                        <li class="mb-2">R2 000 — temporary shelter materials after a flood.</li>
                        <li>R10 000 — a rapid response team deployed for a day.</li>
                    </ul>
                    <hr />
                    <p class="small mb-0">Registered donors can log in to see their donation history and
                        re-download certificates at any time.</p>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
