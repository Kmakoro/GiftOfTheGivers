@using Microsoft.AspNetCore.Identity
@using GiftOfTheGivers.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – Gift of the Givers Foundation</title>
    <meta name="description" content="Gift of the Givers Foundation relief hub: donate, volunteer and follow live disaster relief operations across South Africa." />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg gg-navbar">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-page="/Index">
                    <span class="gg-logo" aria-hidden="true">GG</span>
                    <span class="gg-brand-text">
                        <strong>Gift of the Givers</strong>
                        <small>Foundation</small>
                    </span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item"><a class="nav-link" asp-page="/Index">Home</a></li>
                        <li class="nav-item"><a class="nav-link" asp-page="/About">About</a></li>
                        <li class="nav-item"><a class="nav-link" asp-page="/Projects">Projects</a></li>
                        <li class="nav-item"><a class="nav-link" asp-page="/Donations/Index">Donate</a></li>
                        <li class="nav-item"><a class="nav-link" asp-page="/Volunteers/Register">Volunteer</a></li>
                        <li class="nav-item"><a class="nav-link" asp-page="/Contact">Contact</a></li>
                        @if (User.IsInRole("Employee"))
                        {
                            <li class="nav-item"><a class="nav-link fw-semibold" asp-page="/Employee/Dashboard">Dashboard</a></li>
                        }
                    </ul>
                    <ul class="navbar-nav align-items-lg-center gap-lg-2">
                        @if (SignInManager.IsSignedIn(User))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="Identity" asp-page="/Account/Manage/Index">@User.Identity?.Name</a>
                            </li>
                            <li class="nav-item">
                                <form class="d-inline" asp-area="Identity" asp-page="/Account/Logout"
                                      asp-route-returnUrl="@Url.Page("/Index")" method="post">
                                    <button type="submit" class="btn btn-outline-light btn-sm">Log out</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-area="Identity" asp-page="/Account/Login">Log in</a></li>
                            <li class="nav-item"><a class="nav-link" asp-area="Identity" asp-page="/Account/Register">Register</a></li>
                        }
                        <li class="nav-item">
                            <a class="btn gg-btn-donate btn-sm" asp-page="/Donations/Index">Donate now</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="flex-grow-1">
        @if (TempData["Success"] is string success)
        {
            <div class="container mt-3">
                <div class="alert alert-success">@success</div>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="gg-footer mt-5">
        <div class="container py-4">
            <div class="row gy-3">
                <div class="col-md-5">
                    <h6 class="text-uppercase">Gift of the Givers Foundation</h6>
                    <p class="mb-0 small">Africa's largest disaster response organisation of African origin — delivering
                        swift, effective humanitarian aid where it is needed most.</p>
                </div>
                <div class="col-md-3">
                    <h6 class="text-uppercase">Get involved</h6>
                    <ul class="list-unstyled small mb-0">
                        <li><a asp-page="/Donations/Index">Make a donation</a></li>
                        <li><a asp-page="/Volunteers/Register">Volunteer with us</a></li>
                        <li><a asp-page="/Projects">Active projects</a></li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <h6 class="text-uppercase">Contact</h6>
                    <ul class="list-unstyled small mb-0">
                        <li>info@giftofthegivers.org</li>
                        <li>0800 786 911</li>
                        <li>Pietermaritzburg, South Africa</li>
                    </ul>
                </div>
            </div>
            <hr />
            <p class="small mb-0">&copy; @DateTime.UtcNow.Year Gift of the Givers Foundation — prototype build for academic purposes.</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
