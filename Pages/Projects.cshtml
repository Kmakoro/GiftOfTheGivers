@page
@model GiftOfTheGivers.Pages.ProjectsModel
@{ViewData["Title"]="Relief Projects";ViewData["NavStyle"]="light";}
<section class="page-banner"><div class="container-fluid site-container"><span class="section-eyebrow light">Relief projects</span><h1>Follow ongoing relief work.</h1><p>Project cards are loaded from the database. Updates posted by an Employee appear here publicly.</p></div></section>
<section class="section-pad"><div class="container-fluid site-container"><div class="row g-4">
@if(Model.Projects.Count==0){<div class="col-12"><div class="empty-state">No relief projects are available yet.</div></div>}
@foreach(var p in Model.Projects){var img=p.Title.Contains("Water",StringComparison.OrdinalIgnoreCase)?"https://images.pexels.com/photos/6646878/pexels-photo-6646878.jpeg?auto=compress&cs=tinysrgb&w=1000":p.Title.Contains("Winter",StringComparison.OrdinalIgnoreCase)?"https://images.pexels.com/photos/6591161/pexels-photo-6591161.jpeg?auto=compress&cs=tinysrgb&w=1000":p.Title.Contains("Disaster",StringComparison.OrdinalIgnoreCase)?"https://images.pexels.com/photos/6647178/pexels-photo-6647178.jpeg?auto=compress&cs=tinysrgb&w=1000":"https://images.pexels.com/photos/8061641/pexels-photo-8061641.jpeg?auto=compress&cs=tinysrgb&w=1000";<div class="col-lg-6"><article class="relief-card"><div class="relief-card-media"><img src="@img" alt="Humanitarian relief activity" loading="lazy"/><span class="status-pill">@p.Status</span></div><div class="relief-card-body"><div class="d-flex align-items-center justify-content-between gap-3"><h2>@p.Title</h2><span class="location"><i class="bi bi-geo-alt"></i>@p.Location</span></div><p>@p.Description</p><div class="project-meta"><span><i class="bi bi-calendar3"></i>Started @p.StartDate.ToString("dd MMM yyyy")</span><span><i class="bi bi-clock-history"></i>Updated @p.LastUpdated.ToLocalTime().ToString("dd MMM")</span></div><div class="updates-block"><h3>Latest updates</h3>@if(p.Updates.Count==0){<p class="text-muted small mb-0">No public updates yet.</p>}else{@foreach(var u in p.Updates.OrderByDescending(x=>x.CreatedAt).Take(2)){<div class="public-update"><span></span><div><p>@u.UpdateText</p><small>@u.CreatedAt.ToLocalTime().ToString("dd MMM yyyy • HH:mm")</small></div></div>}}</div></div></article></div>}
</div></div></section>
